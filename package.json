{
  "name": "rwa-interface-contract",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client:generate": "node scripts/generate-dart-client.mjs",
    "api:init": "node scripts/update-contract-client.mjs --init",
    "api:update": "node scripts/update-contract-client.mjs",
    "api:update:branch": "node scripts/update-contract-client.mjs --branch",
    "quality:check": "dart format --output=none --set-exit-if-changed lib test && dart analyze --fatal-infos && flutter test",
    "release:verify": "npm run quality:check",
    "staging:preflight": "node scripts/check-staging-readiness.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.40.1"
  }
}
