# Copy this file to .env and replace all placeholder values.
API_BASE_URL=https://rwa-api-staging.dxd.ink
PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_CLIENT_ID=replace-with-privy-mobile-client-id
PRIVY_APP_URL_SCHEME=rwa
REOWN_PROJECT_ID=replace-with-reown-project-id
# Comma-separated Privy user IDs, account user IDs, Privy DIDs, or login emails.
# This value is public build configuration and must not contain a password.
APP_REVIEW_ENABLED=false
APP_REVIEW_USERS=did:privy:replace-with-review-user-id
